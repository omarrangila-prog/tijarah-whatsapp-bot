# ─────────────────────────────────────────────────────────────────────────────
#  Tijarah WhatsApp Bot — production configuration
#
#  Copy to `.env` beside docker-compose.yml, fill it in, and keep it out of git.
#  The four settings marked  ⚠  decide whether real documents reach real people.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=2785

# ── Database ────────────────────────────────────────────────────────────────
# SQLite is fine for one company at this volume and needs no second service.
# Switch to postgres (and `--profile postgres`) if you outgrow it.
DATABASE_TYPE=sqlite

# ── API access ──────────────────────────────────────────────────────────────
# Written on first boot; read it out of the container and keep it safe.
BOOTSTRAP_KEY_FILE=/app/data/.api-key
# What the agent acts as when it invokes a tool. Give it the LOWEST role the bot
# should ever have — the sender's own role is applied on top of it.
AGENT_API_KEY=

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Baileys is pure Node and pairs by QR. whatsapp-web.js needs a real Chromium.
ENGINE_TYPE=baileys
AUTO_START_SESSIONS=true
WHATSAPP_JOBS_SESSION_ID=tijarah-bot

# ⚠  false = documents are TRANSMITTED to real numbers. Leave true until a test
#    number is paired and you have watched a delivery go out.
WHATSAPP_JOBS_MOCK=true

# Applied to a number written the local way ("03001234567"). Wrong value sends a
# customer's invoice to a stranger abroad.
WHATSAPP_DEFAULT_COUNTRY_CODE=92
# Signed at the foot of every document message. Omitted entirely when unset.
# Quote it: this file is sourced by a shell, and a bare space ends the value.
WHATSAPP_BUSINESS_NAME="Tijarah Books"

# ── The document worker ─────────────────────────────────────────────────────
# ⚠  true = the worker starts claiming jobs and sending them.
WHATSAPP_JOBS_WORKER=true
JOB_POLL_INTERVAL_SECONDS=5
JOB_BATCH_SIZE=10
JOB_CONCURRENCY=3
JOB_MAX_ATTEMPTS=3
JOB_PROCESSING_LEASE_SECONDS=120
DOCUMENT_API_TIMEOUT_SECONDS=30
# Customers' financial documents. Off unless you need to see what went out.
WHATSAPP_JOBS_RETAIN_DOCUMENTS=false

# ── Tijarah Books ───────────────────────────────────────────────────────────
# The API host, NOT my.tijarahbooks.com — that one serves the dashboard app and
# answers every document path with HTML.
DOCUMENT_API_BASE_URL=https://api.tijarabooks.com

# ⚠  true = the bot polls Tijarah's own job queue and sends what it finds.
TIJARAH_QUEUE_ENABLED=true
TIJARAH_QUEUE_BASE_URL=https://api.tijarabooks.com/BotConnectApi
TIJARAH_QUEUE_POLL_SECONDS=15

# ⚠  Where a document composed in chat is sent. This MUST be the endpoint that
#    creates a record on the APPROVAL SCREEN. Unset, drafts are recorded locally
#    and nothing leaves — the safe default.
DRAFT_SUBMIT_ENDPOINT=https://api.tijarabooks.com/TijarahWhatsappBotRequest/UpsertRequest
DRAFT_SUBMIT_AUTH_PROFILE=

# Which create-request types Tijarah's UpsertRequest admits. Its validator accepts these
# four today and refuses the other eight in the specification. When Tijarah widens it,
# add the new names here (e.g. ...,PAYMENT,RECEIVE) and restart — nothing else changes.
# Verified 7 Oct 2026 against the host's own GetActiveRequest: it is storing PAYMENT_DETAILS
# and RECEIVE_DETAILS rows, so those two can be added here. The remaining six (DIGITAL, SALE
# RETURN, PURCHASE RETURN, VENDOR, EXPENSE, ACCOUNT NAME) are built on this side and switch on
# by being named here, once the host's validator admits them.
TIJARAH_REQUEST_TYPES=SALE,PURCHASE,PARTY,ITEM,PAYMENT,RECEIVE

# Phase 3, far side. Polls GetActiveRequest (derived from the endpoint above) so that when
# somebody approves a request on the Tijarah screen, the finished document is fetched and
# sent back to whoever composed it in chat. Nothing here approves anything.
APPROVAL_POLL_ENABLED=true
APPROVAL_POLL_SECONDS=30

# Credentials for a document API that needs them, by profile name. Tijarah's PDF
# endpoints currently need none.
# DOCAPI_TIJARAH_TOKEN=

# ── The agent's reasoner ────────────────────────────────────────────────────
# One key runs the whole bot: aistudio.google.com/apikey
# Without it the rule-based reasoner handles fixed phrasings and free-form
# sentences are not understood — a degradation, not an outage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AGENT_REASONING_MOCK=false

# ⚠  The bot's own WhatsApp channel — replies to people who message it. false = it
#    answers for real as this number. Leave true until the number is a dedicated one.
AGENT_WHATSAPP_MOCK=true

# Serve only numbers mapped to a company in bot_users. Anyone else is told how to get
# registered and nothing more — a stranger must never be shown a company's books.
BOT_REQUIRE_REGISTRATION=true
BOT_REGISTRATION_CONTACT="Hafiz Muhammad Usman on 0330 2417530"

# ── Monitoring ──────────────────────────────────────────────────────────────
# Set to enable GET /api/metrics (bearer-authenticated, disabled when unset).
METRICS_TOKEN=

# ── Demo endpoints ──────────────────────────────────────────────────────────
# Leave false in production. Every route 404s unless this is exactly "true".
MOCK_DOCUMENT_API=false

# ── Reasoning: any OpenAI-compatible host ───────────────────────────────────────
# Optional, and it takes precedence over Gemini when set. Use it for a PAID key, so
# the bot stops degrading to rule-based replies when a free tier runs out.
#
# ⚠  Everything the bot reasons about passes through this host: customer names,
#    account codes, invoice amounts, and every document composed in chat. Point it
#    only at a provider you have a relationship with. There is deliberately no
#    default — unset, this stays dormant and Gemini answers instead.
#
# ⚠  ALL THREE must be filled in. A key on its own leaves this dormant and the bot
#    falls back to fixed phrasings — which is why "trial balance" worked and
#    "trail balance" did not. /api/agent/status and the Document Delivery screen
#    both say which reasoner is actually answering; check there after a change.
#
# Examples (pick one, set all three):
#   Moonshot (Kimi)  AI_BASE_URL=https://api.moonshot.ai/v1   AI_MODEL=kimi-k2
#   DeepSeek         AI_BASE_URL=https://api.deepseek.com/v1  AI_MODEL=deepseek-chat
#   OpenAI           AI_BASE_URL=https://api.openai.com/v1    AI_MODEL=gpt-4o-mini
#   A reseller       AI_BASE_URL=<their host>/v1              AI_MODEL=<a model they list>
#                    (GET <host>/v1/models with the key lists what it may use)
#   e.g. openai.fans AI_BASE_URL=https://api.openai.fans/v1   AI_MODEL=claude-sonnet-5
#
# A bare host ("https://api.openai.fans") gets /v1 added. Without it that reseller answered
# with its own web page and the bot quietly fell back to fixed phrasings.
#
# With a model set, a client's request the fixed rules read with certainty (a document by
# number, a named report) is still answered by the rules; the model answers everything else.
#
# The key itself belongs ONLY in this file, which is git-ignored. This repository
# is public: a key committed here is a key given away.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Voice notes. Transcribed with the AI provider above (OpenAI-compatible /audio/transcriptions) unless
# these point at another one. Without a working transcriber the bot asks people to type instead.
# Not every reseller serves a transcription model (api.openai.fans does not, checked 9 Oct 2026):
# then set TRANSCRIBE_ENABLED=false, or point the TRANSCRIBE_* keys at a provider that does.
# TRANSCRIBE_ENABLED=false
TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_LANGUAGE=

# ── API-key hashing ─────────────────────────────────────────────────────────────
# ⚠  SET THIS BEFORE THE FIRST BOOT, and never change it afterwards.
#
#    Stored API-key hashes are peppered with it. Unset, the app auto-generates one
#    into data/.env.generated — and if that file is ever recreated (a wiped volume,
#    a deploy run from a second clone of this repo), every existing key stops
#    validating with "Invalid API key" while still looking correct in data/.api-key.
#    That is not a theoretical failure: it happened on the first real deployment.
#
#    Generate one with:  openssl rand -hex 32
API_KEY_PEPPER=

# Reply to people who are not clients? Leave unset on a business number: the bot stays
# silent for them and the team answers from the inbox. Set true only on a dedicated bot
# number, where everyone who writes is a would-be client.
BOT_REGISTRATION_REPLY=
