# Safe local run of the WhatsApp agent channel.
#
# Deliberately isolated from production: its own database, no WhatsApp sessions, and the
# agent's transport forced to the in-memory mock. Nothing here can reach the real
# Odoovations number or any customer.
NODE_ENV=development
PORT=3112
SERVE_DASHBOARD=true

# Throwaway database in the scratchpad — NOT ~/wa-command-center/data/*.sqlite
DATABASE_TYPE=sqlite
DATABASE_NAME=${DEMO_HOME}/data/agent.sqlite
MAIN_DATABASE_NAME=${DEMO_HOME}/data/main.sqlite
BOOTSTRAP_KEY_FILE=${DEMO_HOME}/data/.api-key
SESSION_DATA_PATH=${DEMO_HOME}/data/sessions
STORAGE_LOCAL_PATH=${DEMO_HOME}/data/media

# No engine starts, so no QR and no connection to any account.
AUTO_START_SESSIONS=false

# The agent cannot transmit: sends are recorded in memory with a mock. id.
AGENT_WHATSAPP_MOCK=true
# Deterministic reasoner, so the demo needs no model API key.
AGENT_REASONING_MOCK=false


# --- Phase 1: WhatsApp document delivery ---
# The demo document API, which returns a real (generated) PDF.
MOCK_DOCUMENT_API=true
# The endpoint column already carries the /api prefix (see §7), so the base is the host root.
DOCUMENT_API_BASE_URL=https://api.tijarabooks.com
# The transport records instead of transmitting. Set to false only with a test number attached.
WHATSAPP_JOBS_MOCK=false
WHATSAPP_JOBS_WORKER=true
JOB_POLL_INTERVAL_SECONDS=5
JOB_BATCH_SIZE=10
JOB_MAX_ATTEMPTS=3
JOB_PROCESSING_LEASE_SECONDS=120
DOCUMENT_API_TIMEOUT_SECONDS=30

# Which session the worker sends through when WHATSAPP_JOBS_MOCK=false.
WHATSAPP_JOBS_SESSION_ID=jobs-test

# Baileys is pure Node. The default engine (whatsapp-web.js) drives a real Chromium, which
# cannot start in this sandbox — snap fails to build its mount namespace — so a session on it
# sits in "initializing" forever. Baileys pairs by QR just the same and has no browser.
ENGINE_TYPE=baileys

# Prometheus scrape endpoint. Gated by a bearer token rather than the API key, and disabled
# entirely when unset — this value is a throwaway for the demo instance.
METRICS_TOKEN=demo-metrics-token

# Tijarah Books queues its own work: GetPendingBotInvoices lists what is waiting and
# MarkInvoiceProcessed acknowledges a delivery so the row stops being offered.
TIJARAH_QUEUE_ENABLED=true
TIJARAH_QUEUE_BASE_URL=https://api.tijarabooks.com/BotConnectApi
TIJARAH_QUEUE_POLL_SECONDS=15
# Bare national numbers ("03000000000") get this country code. Wrong value = a customer's
# invoice delivered to a stranger abroad, so it is configuration rather than a guess.
WHATSAPP_DEFAULT_COUNTRY_CODE=92

# Signed at the foot of every document message. Omitted entirely when unset — never invented.
WHATSAPP_BUSINESS_NAME="Tijarah Books"

# Only numbers mapped to a company in bot_users are served. Anyone else is told how to get
# registered and nothing more — a stranger must never be shown a company's books.
BOT_REQUIRE_REGISTRATION=true
BOT_REGISTRATION_CONTACT="Hafiz Muhammad Usman on 0330 2417530"

# Phase 3: where a composed document goes. This is the approval screen — PENDING rows only,
# never an entry. Unset it and drafts are recorded locally instead.
DRAFT_SUBMIT_ENDPOINT=https://api.tijarabooks.com/TijarahWhatsappBotRequest/UpsertRequest

# Phase 3, far side: poll GetActiveRequest so an approved document is fetched and sent back
# to whoever composed it. Off unless DRAFT_SUBMIT_ENDPOINT points at a real host.
APPROVAL_POLL_ENABLED=true
APPROVAL_POLL_SECONDS=30

# What UpsertRequest admits today. Add PAYMENT,RECEIVE etc. when Tijarah's validator does.
TIJARAH_REQUEST_TYPES=SALE,PURCHASE,PARTY,ITEM

# Any OpenAI-compatible reasoner, and it wins over Gemini when all three are set.
# Left blank: the demo runs on the Gemini key, and a stray host here would send a
# customer's ledger somewhere nobody chose.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
