# Rangila — the real team inbox.
#
# THIS IS PRODUCTION DATA. It runs against ./data/openwa.sqlite and ./data/baileys, which hold
# real customer conversations and the credentials for the live Odoovations WhatsApp number.
# Nothing here overrides a database path, deliberately: the defaults in config/configuration.ts
# already point at the real files, and a stray override here would silently start a second,
# empty instance that looks like data loss.
#
# The agent demonstration is a separate instance on :3111 with its own throwaway database
# (scripts/agent-demo). The two never share state.
NODE_ENV=development
PORT=3000
SERVE_DASHBOARD=true

# Sessions must be told to start. Without this the dashboard loads, the inbox looks normal and
# every send fails — the engine is simply not connected.
AUTO_START_SESSIONS=true
